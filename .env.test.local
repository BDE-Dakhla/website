# E2E Test Environment Configuration
# This file is used by Playwright for end-to-end testing

# Database
DATABASE_URL="postgresql://postgres:test@localhost:5432/test"

# Authentication
AUTH_NEXTAUTH_SECRET="test-secret-for-playwright-testing"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LANG="fr"

# Email (for testing)
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER="test@test.com"
SMTP_PASS="test-password"
SMTP_FROM_EMAIL="noreply@test.com"
SMTP_FROM_NAME="Test App"

# Security
APP_HMAC_SECRET="test-hmac-secret-for-tokens"
CRON_SECRET="test-cron-secret"

# CI Configuration
NODE_ENV="test"
BASE_URL="http://localhost:3000"
CI="true"